  activities         Activity[]

  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
  @@index([assignedUserId])
  @@index([deletedAt, status])
  @@index([issueDate])
  @@index([validUntil])
  @@index([updatedAt])
  @@map("quotes")
}

model QuoteItem {
  id                 String   @id @default(cuid())
  quoteId            String   @map("quote_id")
  quote              Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position           Int
  title              String
  description        String?
  // Thousandths: 1500 = 1.5 units. Money calculations use BigInt intermediates.
  quantity           Int
  unit               String

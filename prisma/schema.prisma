model InvoiceItem {
  id                 String   @id @default(cuid())
  invoiceId          String   @map("invoice_id")
  invoice            Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position           Int
  title              String
  description        String?
  // Thousandths: 1500 = 1.5 units. Money calculations use BigInt intermediates.
  quantity           Int
  unit               String
  unitPriceCents     Int      @map("unit_price_cents")
  taxRateBasisPoints Int      @map("tax_rate_basis_points")
  lineSubtotalCents  Int      @map("line_subtotal_cents")
  lineTaxCents       Int      @map("line_tax_cents")
  lineTotalCents     Int      @map("line_total_cents")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([invoiceId, position])
  @@map("invoice_items")
}

// Phase 14: regelbasierte interne Erinnerungen (keine KI, keine Kundenmails).
enum ReminderType {
  QUOTE_OPEN
  DEAL_INACTIVE
  FOLLOW_UP_DUE
  TASK_OVERDUE
  INVOICE_OVERDUE

  @@map("reminder_type")
}

// PENDING: erzeugt, Mail noch nicht gesendet. SENDING: von genau einem Job
// beansprucht (wird nach Absturz NIE automatisch erneut gesendet). SENT:
// interne Mail zugestellt. FAILED: SMTP-Fehler, wird begrenzt erneut versucht.
// NO_ASSIGNEE / INACTIVE_ASSIGNEE: nur im CRM sichtbar, keine Mail.
// RESOLVED: Zustand erledigt oder manuell geschlossen.
enum ReminderStatus {
  PENDING
  SENDING
  SENT
  FAILED
  NO_ASSIGNEE
  INACTIVE_ASSIGNEE
  RESOLVED

  @@map("reminder_status")
}

// Bewusst mehrere nullable FKs statt polymorpher entityType/entityId-Paare:
// echte Fremdschlüssel (Integrität, Joins ohne N+1) - genau einer ist gesetzt
// (CHECK num_nonnulls = 1 in der Migration). dedupeKey = Typ:Entität:Zustand
// und UNIQUE: derselbe Zustand erzeugt nie zweimal eine Erinnerung/Mail,
// auch bei parallelen Jobs oder Neustarts.
model Reminder {
  id             String         @id @default(cuid())
  type           ReminderType
  status         ReminderStatus @default(PENDING)
  dedupeKey      String         @unique @map("dedupe_key")
  assignedUserId String?        @map("assigned_user_id")
  assignedUser   User?          @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  quoteId        String?        @map("quote_id")
  quote          Quote?         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  dealId         String?        @map("deal_id")
  deal           Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  leadId         String?        @map("lead_id")
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  taskId         String?        @map("task_id")
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  invoiceId      String?        @map("invoice_id")
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  triggeredAt    DateTime       @default(now()) @map("triggered_at")
  emailSentAt    DateTime?      @map("email_sent_at")
  resolvedAt     DateTime?      @map("resolved_at")
  attempts       Int            @default(0)
  lastError      String?        @map("last_error")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([status, type])
  @@index([assignedUserId, status])
  @@map("reminders")
}

// Singleton wie SystemSettings. Standardmäßig ALLES deaktiviert: beim ersten
// Deployment existiert ein Rückstau überfälliger Vorgänge; der OWNER schaltet
// die Erinnerungen bewusst ein, nachdem SMTP und Timer geprüft sind.
model ReminderSettings {
  id              String   @id @default(cuid())
  singleton       Boolean  @unique @default(true)
  quoteEnabled    Boolean  @default(false) @map("quote_enabled")
  quoteDays       Int      @default(7) @map("quote_days")
  dealEnabled     Boolean  @default(false) @map("deal_enabled")
  dealDays        Int      @default(14) @map("deal_days")
  followUpEnabled Boolean  @default(false) @map("follow_up_enabled")
  taskEnabled     Boolean  @default(false) @map("task_enabled")
  invoiceEnabled  Boolean  @default(false) @map("invoice_enabled")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("reminder_settings")
}

// Phase 15: Dateien in der Kundenakte. Inhalt liegt NICHT in der Datenbank,
// sondern im privaten Upload-Verzeichnis (CRM_UPLOAD_DIR) unter dem zufälligen
// storedName. Genau ein Ziel (echte FKs, CHECK in der Migration). Löschen =
// Soft Delete der Metadaten + physisches Entfernen der Datei.
model FileAttachment {
  id               String    @id @default(cuid())
  originalName     String    @map("original_name")
  storedName       String    @unique @map("stored_name")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  uploadedByUserId String    @map("uploaded_by_user_id")
  uploadedBy       User      @relation("FileUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  companyId        String?   @map("company_id")
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId        String?   @map("contact_id")
  contact          Contact?  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  dealId           String?   @map("deal_id")
  deal             Deal?     @relation(fields: [dealId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([companyId, deletedAt])
  @@index([contactId, deletedAt])
  @@index([dealId, deletedAt])
  @@map("file_attachments")
}

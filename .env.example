# Vorlage für .env – diese Datei wird committed, .env selbst NICHT.
# Kopieren nach .env und mit echten Werten füllen:
#   cp .env.example .env

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rdevolution_crm?schema=public"
# Pflicht: DATABASE_URL, AUTH_SECRET, LOGIN_RATE_LIMIT_SECRET.
# NEXTAUTH_URL: öffentliche Basis-URL; in Produktion explizit HTTPS setzen.
# INITIAL_OWNER_*: nur beim ersten Seed erforderlich, danach entfernen.
# SMTP_*: optional; ohne vollständige gültige Konfiguration kein Versand.

# Generieren mit: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL ist der bevorzugte Auth.js-Name; NEXTAUTH_URL bleibt kompatibel.
# Bei paralleler Konfiguration müssen beide dieselbe Basis-URL enthalten.
# AUTH_URL="http://localhost:3000"

# Eigenes Secret für das Login-Rate-Limiting (HMAC-Schlüssel), unabhängig von
# AUTH_SECRET. Generieren mit: openssl rand -base64 32
LOGIN_RATE_LIMIT_SECRET=""

# Nur für das einmalige, idempotente Seed-Script (npm run db:seed).
# Niemals produktive Zugangsdaten hier eintragen oder committen.
INITIAL_OWNER_EMAIL=""
INITIAL_OWNER_PASSWORD=""
INITIAL_OWNER_FIRST_NAME=""
INITIAL_OWNER_LAST_NAME=""

# SMTP (nur serverseitig; keine NEXT_PUBLIC_* Variablen).
# Port 465: SMTP_SECURE=true; Port 587: false, STARTTLS wird erzwungen.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="RDEvolution GbR"
SMTP_REPLY_TO=""

# Nur für Integrationstests: separate DB, Name endet auf _test oder enthält _test_.
TEST_DATABASE_URL=""
# Nur Backup/Restore: extern bereitstellen, nicht Teil der App-Konfiguration.
BACKUP_DIR=""
BACKUP_RETENTION_DAYS="14"
# Optional: Verzeichnis der pg_dump/pg_restore Programme, sonst PATH.
PG_BIN=""
RESTORE_DATABASE_URL=""
RESTORE_CONFIRM=""

# Phase 15: privater Speicher fuer Datei-Uploads (Kundenakte). In Produktion PFLICHT,
# absoluter Pfad ausserhalb des App-Verzeichnisses und von public/, Besitzer crm:crm,
# Modus 700, z. B. /srv/rdevolution-crm-data/uploads. Lokal ohne Wert: .data/uploads.
# Dateien sind NICHT Teil des PostgreSQL-Backups - Verzeichnis separat sichern.
CRM_UPLOAD_DIR=""

# Nur für das lokale PostgreSQL in docker-compose.dev.yml.
# Eigenes starkes Kennwort in .env setzen; niemals committen.
CRM_DEV_DB_PASSWORD=""

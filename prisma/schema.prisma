  company            Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contactId          String?        @map("contact_id")
  contact            Contact?       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  dealId             String?        @map("deal_id")
  deal               Deal?          @relation(fields: [dealId], references: [id], onDelete: Restrict)
  assignedUserId     String         @map("assigned_user_id")
  assignedUser       User           @relation("QuoteAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  createdById        String         @map("created_by_id")
  createdBy          User           @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  issueDate          DateTime       @map("issue_date") @db.Date
  validUntil         DateTime       @map("valid_until") @db.Date
  currency           String
  subtotalCents      Int            @map("subtotal_cents")
  taxCents           Int            @map("tax_cents")
  totalCents         Int            @map("total_cents")
  taxRateBasisPoints Int            @default(1900) @map("tax_rate_basis_points")
  issuerName         String         @map("issuer_name")
